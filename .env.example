# Copy this file to ".env" and fill in YOUR OWN vtiger credentials.
# The .env file is git-ignored — never commit real keys.

# Base URL of your vtiger CRM (no trailing /webservice.php)
VTIGER_URL=https://yourcrmdomain.com

# Your vtiger login (the username you sign in to the portal with)
VTIGER_USERNAME=your.username

# Your "Webservice Access Key" — find it in the portal under
# My Preferences -> "Webservice Access Key" (NOT your login password)
VTIGER_ACCESS_KEY=your-16-char-access-key

# Safety guard: destructive deletes are OFF unless you set this to "true"
VTIGER_ALLOW_DELETE=false

# ---------------------------------------------------------------------------
# OPTIONAL — timesheet module mapping.
# Defaults target the "TimeControl" layout. Override ONLY if your vtiger
# install uses a different module or field names for time tracking. The
# generic create_record / query tools work regardless of these.
# ---------------------------------------------------------------------------
# VTIGER_TIMESHEET_MODULE=TimeControl
# VTIGER_TASK_MODULE=ProjectTask
# VTIGER_PROJECT_MODULE=Project

# Field-name overrides on the timesheet module (advanced):
# VTIGER_TS_DATE_START_FIELD=date_start
# VTIGER_TS_DATE_END_FIELD=date_end
# VTIGER_TS_TIME_START_FIELD=time_start
# VTIGER_TS_TIME_END_FIELD=time_end
# VTIGER_TS_RELATED_FIELD=related_to
# VTIGER_TS_DESC_FIELD=description
# VTIGER_TS_HOURSTYPE_FIELD=hours_type
# VTIGER_TS_TOTAL_FIELD=totaltime
# VTIGER_TS_OWNER_FIELD=assigned_user_id
# VTIGER_TASK_NAME_FIELD=projecttaskname
# VTIGER_TASK_PROJECT_FIELD=projectid
# VTIGER_PROJECT_NAME_FIELD=projectname
