# Copy this file to ".env" and fill in YOUR OWN vtiger credentials.
# The .env file is git-ignored — never commit real keys.

# Base URL of your vtiger CRM (no trailing /webservice.php)
VTIGER_URL=https://yourcrmdomain.com

# Your vtiger login (the username you sign in to the portal with)
VTIGER_USERNAME=your.username

# Your "Webservice Access Key" — find it in the portal under
# My Preferences -> "Webservice Access Key" (NOT your login password)
VTIGER_ACCESS_KEY=your-16-char-access-key

# Safety guard: destructive deletes are OFF unless you set this to "true"
VTIGER_ALLOW_DELETE=false
